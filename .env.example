# Copy to .env for local runs, or set these in Railway -> Variables.
# Public address that receives USDC (NOT a private key or recovery phrase).
PAY_TO=
# Solana mainnet RPC, e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=
# Your service's public URL, e.g. https://solana-token-safety-production.up.railway.app
PUBLIC_URL=
# Price per report in USD (default 0.02)
PRICE_USD=0.02
# mainnet (default) or devnet
NETWORK=mainnet
